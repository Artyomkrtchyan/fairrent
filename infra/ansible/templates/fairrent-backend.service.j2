[Unit]
Description=FairRent backend container
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
PartOf=docker.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=root
UMask=0077
RuntimeDirectory=fairrent-backend
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/sbin/fairrent-backend-start.py
ExecStop=-/usr/bin/docker stop --time 30 fairrent-backend
Restart=always
RestartSec=20
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
