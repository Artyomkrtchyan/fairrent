# B07: verify artifact loading and predictions in a container with the backend image's Python (3.10).
# Build from the repository root:
#   docker build -f ml/docker/Dockerfile.verify -t fairrent-b07-verify .
#   docker run --rm -v "<abs path to artifacts/b07/VERSION>:/package:ro" fairrent-b07-verify
FROM python:3.10-slim

WORKDIR /app
COPY ml/requirements.txt ml/requirements-inference.txt ./ml/
RUN pip install --no-cache-dir -r ml/requirements-inference.txt "jsonschema>=4.20"

COPY ml/ ./ml/
# Only the geography registry is needed from data_pipeline (A05); nothing database-related.
COPY data_pipeline/__init__.py data_pipeline/geography.py ./data_pipeline/
COPY contracts/openapi.json ./contracts/openapi.json

ENV FAIRRENT_MODEL_PACKAGE=/package PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "ml.verify_package"]
