# Public browser configuration. Never put credentials here.
VITE_API_MODE=mock

# Used only in real mode.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional MapLibre style URL. Default: OpenFreeMap Liberty.
# Browser-visible URL; never include a secret key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
